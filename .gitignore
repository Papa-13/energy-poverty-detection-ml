# Ignore large data files
*.xlsx
*.csv
*.parquet
*.h5

# Exception: the reproducibility data sample is intentionally committed
# (see reproducibility/README.md -- the original sampling seed was lost,
# so this sample is the only way downstream results stay reproducible).
!reproducibility/data/*.csv

# Ignore model files
*.pkl
*.joblib

# Ignore Jupyter checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Ignore Python cache
__pycache__/
*.pyc

# Ignore environment
.env
venv/